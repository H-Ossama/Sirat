<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_athkar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- Accent Bar Top -->
    <View
        android:id="@+id/accent_bar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_accent_bar" />

    <!-- Title -->
    <TextView
        android:id="@+id/athkar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/accent_bar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:text="أذكار اليوم"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />

    <!-- Athkar Status -->
    <TextView
        android:id="@+id/athkar_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/athkar_title"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:text="أذكار الصباح ☀️"
        android:textColor="@color/widget_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Action Pill -->
    <TextView
        android:id="@+id/athkar_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/widget_accent_pill"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="اضغط للقراءة"
        android:textColor="@color/widget_today_text"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>
