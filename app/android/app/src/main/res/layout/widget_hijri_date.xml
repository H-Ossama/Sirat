<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_hijri_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- Accent Bar Top -->
    <View
        android:id="@+id/accent_bar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_accent_bar" />

    <!-- Day Name Badge -->
    <TextView
        android:id="@+id/hijri_day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/accent_bar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_accent_pill"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:text="الجمعة"
        android:textColor="@color/widget_today_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Hijri Date (Big) -->
    <TextView
        android:id="@+id/hijri_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/hijri_day_name"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:text="15 رمضان"
        android:textColor="@color/widget_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Hijri Year -->
    <TextView
        android:id="@+id/hijri_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/hijri_date"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:text="1447 هـ"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />

    <!-- Gregorian Date -->
    <TextView
        android:id="@+id/gregorian_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text="18 مارس 2026"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp" />

</RelativeLayout>
