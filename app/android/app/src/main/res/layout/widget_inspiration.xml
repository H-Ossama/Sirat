<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_inspiration_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_premium"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/inspiration_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="رسالة اليوم"
            android:textColor="@color/widget_text_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/inspiration_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="جاري التحميل..."
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/inspiration_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</RelativeLayout>
