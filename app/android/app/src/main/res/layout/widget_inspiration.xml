<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_inspiration_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- Accent Bar Top -->
    <FrameLayout
        android:id="@+id/accent_bar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_accent_bar" />

    <!-- Label -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/accent_bar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:text="رسالة اليوم"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp" />

    <!-- Source Pill (Moved up for safer layout reference) -->
    <TextView
        android:id="@+id/inspiration_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:background="@drawable/widget_pill_bg"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="..."
        android:textColor="@color/widget_text_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Inspiration Text (Now clearly above the source) -->
    <TextView
        android:id="@+id/inspiration_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_label"
        android:layout_above="@id/inspiration_source"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:lineSpacingExtra="4dp"
        android:text="جاري التحميل..."
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="4"
        android:ellipsize="end" />

</RelativeLayout>
